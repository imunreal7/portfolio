{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "framer-motion": "^10.16.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "lint": "eslint src --ext .js,.jsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.5.28",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.5",
    "tailwindcss": "^3.3.3"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "$postcss",
    "serialize-javascript": "^7.1.1",
    "@svgr/webpack": "^8.1.0",
    "uuid": "^11.1.1",
    "workbox-build": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1",
    "underscore": "^1.13.8",
    "qs": "^6.16.0",
    "@tootallnate/once": "^2.0.1"
  }
}
